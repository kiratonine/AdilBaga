# Production uses only HTTP. Development/unit tests may explicitly use mock.
NEXT_PUBLIC_API_MODE=http
# Адрес API для браузера (запросы идут на ${base}/api/...)
NEXT_PUBLIC_API_BASE_URL=https://api.aktau.market
# Адрес API для сервера Next (внутренний); не задан — берётся NEXT_PUBLIC_API_BASE_URL
# API_BASE_URL=http://api:8080
# Публичный адрес сайта (без / в конце) — для canonical, hreflang, Open Graph, JSON-LD, sitemap и robots.
# Planned production origin; required at production build/start.
NEXT_PUBLIC_SITE_URL=https://aktau.market
# Test-only opt-in for Playwright mock production builds. Never enable in deployment.
# NEXT_PUBLIC_ENABLE_TEST_MOCKS=1
# Server-only; private shared ingestion/webhook secret (at least 32 random bytes).
REVALIDATE_HMAC_SECRET=
