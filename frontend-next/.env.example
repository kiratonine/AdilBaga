# mock — фикстуры из src/mocks/, http — настоящий API
NEXT_PUBLIC_API_MODE=mock
# Адрес API для браузера (запросы идут на ${base}/api/...)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Адрес API для сервера Next (внутренний); не задан — берётся NEXT_PUBLIC_API_BASE_URL
# API_BASE_URL=http://api:8080
