# Copy to /etc/aktau-sync.env (chmod 600, owner aktau-sync). Fill the empty values; never commit real ones.
APP_ENV=production
INGEST_DATABASE_URL=
INGEST_MAX_STORE_DROP_PERCENT=10
INGEST_PRODUCTION_APPLY_CONFIRM=1
SYNC_STORES=DINA,DANA,FIX_PRICE
# Fix Price: город Актау (docs/data/FIXPRICE_SOURCE.md); без них scrape:fixprice падает и весь sync останавливается
FIXPRICE_CITY_ID=1594
FIXPRICE_COUNTRY_ID=3
FRONTEND_REVALIDATE_URL=https://aktau.market/internal/revalidate
REVALIDATE_HMAC_SECRET=
