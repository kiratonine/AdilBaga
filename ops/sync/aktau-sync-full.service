[Unit]
Description=Aktau Market weekly full catalog scrape (no publish)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aktau-sync
WorkingDirectory=/opt/aktau-sync
# Из env-файла нужны только FIXPRICE_*; INGEST_* и REVALIDATE_* скрипт не читает (ingest не запускается)
EnvironmentFile=/etc/aktau-sync.env
# systemd не читает профиль: Go лежит в /usr/local/go/bin, а у системного пользователя нет HOME и GOCACHE
Environment=PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/aktau-sync
Environment=GOCACHE=/var/cache/aktau-sync/go
StateDirectory=aktau-sync
CacheDirectory=aktau-sync
ExecStart=/usr/bin/bash pipeline/scripts/weekly-full-scrape.sh
TimeoutStartSec=2h
