GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_MODEL=gemini-3.1-flash-lite
# Пауза между запросами к Gemini, мс. 4000 ≈ 15 запросов в минуту (free-уровень); на платном тарифе можно 0
GEMINI_MIN_INTERVAL_MS=4000
# Fix Price: id города Актау и заголовки, найденные в Task 4
FIXPRICE_CITY_ID=
FIXPRICE_COUNTRY_ID=3
FIXPRICE_COUNTRY_ID=3
# Анвар: значения из docs/data/ANVAR_SOURCE.md (Task 12). Не коммитить.
ANVAR_API_BASE=
ANVAR_API_TOKEN=
ANVAR_STORE_ID=
