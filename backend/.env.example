# PostgreSQL / Supabase connection URL
# DATABASE_URL: Pooler connection string (Transaction mode, port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adil_baga?schema=public"
# DIRECT_URL: Direct / Session connection string (Session mode, port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/adil_baga?schema=public"

# Optional Gemini API key for ambiguous candidate validation
GEMINI_API_KEY=""

# Application Port (Backend 1)
PORT=3001
