{
  "name": "adilbaga-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify_db.ts",
    "import:dina": "tsx src/modules/import/scrapers/dina.scraper.ts",
    "import:dana": "tsx src/modules/import/scrapers/dana.scraper.ts",
    "import:fixprice": "tsx src/modules/import/scrapers/fixprice.loader.ts",
    "data:pipeline": "tsx scripts/pipeline.ts",
    "data:report": "tsx scripts/report.ts",
    "test:matching": "tsx src/modules/matching/matcher.test.ts",
    "test:audit": "tsx scripts/audit_suite.ts",
    "test:live-api": "tsx scripts/test_live_api.ts",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "test": "DATA_SOURCE=fixture node --test dist/test/*.test.js",
    "archive:clean": "node ../scripts/create-clean-archive.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
