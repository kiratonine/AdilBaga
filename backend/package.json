    "@upstash/redis": "^1.39.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.32.1"
}
