datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StoreCode {
  DINA
  DANA
  FIX_PRICE
}

enum MatchMethod {
  barcode
  deterministic
  ai
  manual
}

enum ReviewStatus {
  approved
  pending
  rejected
}

enum SnapshotStatus {
  building
  validating
  published
  failed
}

enum SourceRunStatus {
  pending
  succeeded
  failed
}

model Snapshot {
  id            String         @id @default(uuid())
  status        SnapshotStatus @default(building)
  startedAt     DateTime       @default(now())
  publishedAt   DateTime?
  sourceStats   Json           @default("{}")
  qualityReport Json           @default("{}")
  createdAt     DateTime       @default(now())
  rawProducts   RawProduct[]
  offers        Offer[]
  sourceRuns    SourceRun[]

  @@index([status, publishedAt])
  @@index([publishedAt])
  @@map("snapshots")
}

model SourceRun {
  id           String          @id @default(uuid())
  snapshotId   String
  snapshot     Snapshot        @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  status       SourceRunStatus @default(pending)
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  capturedAt   DateTime?
  productCount Int             @default(0)
  errorCount   Int             @default(0)
  errorSummary String?
  sourceStats  Json            @default("{}")

  @@unique([snapshotId, storeId])
  @@index([storeId, status, capturedAt])
  @@map("source_runs")
}

model Store {
  id          String          @id @default(uuid())
  code        StoreCode       @unique
  name        String
  logoUrl     String?
  locations   StoreLocation[]
  rawProducts RawProduct[]
  offers      Offer[]
  sourceRuns  SourceRun[]

  @@map("stores")
}

model StoreLocation {
  id        String @id @default(uuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  address   String
  latitude  Float
  longitude Float

  @@index([storeId])
  @@map("store_locations")
}

model Category {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  filterSchema      Json?
  canonicalProducts CanonicalProduct[]

  @@map("categories")
}

model RawProduct {
  id              String   @id @default(uuid())
  snapshotId      String
  snapshot        Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceProductId String
  sourceUrl       String?
  rawName         String
  rawBrand        String?
  rawCategory     String?
  rawPrice        Int
  rawOldPrice     Int?
  rawImageUrl     String?
  rawPayload      Json?
  createdAt       DateTime @default(now())

  mappings ProductMapping[]
  offers   Offer[]

  @@unique([snapshotId, storeId, sourceProductId])
  @@unique([id, snapshotId])
  @@index([storeId])
  @@index([rawCategory])
  @@map("raw_products")
}

model CanonicalProduct {
  id         String   @id @default(uuid())
  name       String
  brand      String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl   String?
  attributes Json?
  createdAt  DateTime @default(now())

  mappings ProductMapping[]
  offers   Offer[]

  @@index([categoryId])
  @@index([brand])
  @@map("canonical_products")
}

model ProductMapping {
  id                 String           @id @default(uuid())
  rawProductId       String
  rawProduct         RawProduct       @relation(fields: [rawProductId], references: [id], onDelete: Cascade)
  canonicalProductId String
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  matchMethod        MatchMethod
  matchConfidence    Float            @default(1.0)
  reviewStatus       ReviewStatus     @default(approved)
  createdAt          DateTime         @default(now())

  @@index([rawProductId])
  @@index([canonicalProductId])
  @@map("product_mappings")
}

model Offer {
  id                 String           @id @default(uuid())
  snapshotId         String
  snapshot           Snapshot         @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  canonicalProductId String
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  rawProductId       String
  rawProduct         RawProduct       @relation(fields: [rawProductId, snapshotId], references: [id, snapshotId], onDelete: Cascade)
  storeId            String
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  price              Int
  oldPrice           Int?
  inStock            Boolean          @default(true)
  snapshotAt         DateTime         @default(now())

  @@index([canonicalProductId])
  @@index([storeId])
  @@index([price])
  @@index([snapshotAt])
  @@index([snapshotId])
  @@index([snapshotId, canonicalProductId])
  @@index([snapshotId, storeId])
  @@map("offers")
}
